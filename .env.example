PEKUA_ENVIRONMENT=development
# Compose-only infrastructure credentials. Generate unique values and keep the
# production values in the deployment secret manager, not in this file.
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
NEO4J_PASSWORD=change-me
PEKUA_DATABASE_URL=postgresql+asyncpg://pekua:change-me@postgres:5432/pekua
PEKUA_OBJECT_STORE_ENDPOINT=http://minio:9000
PEKUA_OBJECT_STORE_BUCKET=pekua-documents
PEKUA_OBJECT_STORE_ACCESS_KEY=change-me
PEKUA_OBJECT_STORE_SECRET_KEY=change-me
PEKUA_NEO4J_URI=bolt://neo4j:7687
PEKUA_NEO4J_USER=neo4j
PEKUA_NEO4J_PASSWORD=change-me
PEKUA_VAULT_PROVIDER=environment
# Local development only: generate a fresh 32-byte URL-safe base64 value.
PEKUA_DEV_VAULT_KEY=
